<MainLayout>:
    orientation: "vertical"
    padding: 20
    spacing:15
    TextInput:
        id: link_input
        hint_text: "粘贴BV号/AV号/视频链接"
        size_hint_y: None
        height: 44
    Button:
        text:"解析视频"
        on_press: root.parse_click()
        size_hint_y: None
        height:44
    Spinner:
        id: quality
        text:"选择画质"
        values:[]
        size_hint_y: None
        height:44
    Button:
        text:"开始下载合并"
        on_press: root.download_clicked()
        size_hint_y: None
        height:44
    ProgressBar:
        id: progress
        value:0
    Label:
        id: status
        text:"就绪"
        size_hint_y: None
        height:40
